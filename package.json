{
  "name": "vibe-rails",
  "version": "0.2.0",
  "description": "Guard rails for vibe coding: a plain-language interview, a tested scope, and a hard test gate before every save.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirHoseinSafari/Vibe-Rails.git"
  },
  "bin": {
    "vibe-rails": "bin/vibe-rails"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "skills",
    "hooks",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
