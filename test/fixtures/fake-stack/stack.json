{
  "name": "fake",
  "description": "Test double: 'runs' the tests listed in tests.json.",
  "nodeMajor": 20,
  "commands": {
    "install": "",
    "test": "node run-tests.cjs",
    "dev": "node dev-server.cjs"
  },
  "report": {
    "format": "jest-json",
    "file": ".vibe-rails/tmp/report.json"
  },
  "testMatch": "\\.test\\.",
  "notes": [
    "About the starter: tests are listed in tests.json."
  ],
  "structure": {
    "sourceDir": "src",
    "extensions": [
      "js"
    ],
    "maxFileLines": 30,
    "modules": "src/features/",
    "storage": {
      "pattern": "\\blocalStorage\\b",
      "only": "src/data/"
    },
    "ignore": [
      "src/setup.js"
    ]
  }
}
